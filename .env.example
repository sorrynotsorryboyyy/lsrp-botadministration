# Modèle de configuration — NE JAMAIS y mettre de vraies valeurs.
# Ce fichier est versionné par git. Copiez-le en `.env` (ignoré) pour vos secrets.

# Bot Discord
DISCORD_TOKEN=votre_token_discord
GUILD_ID=id_de_votre_serveur

# Base de données — utilisez MYSQL_PUBLIC_URL depuis Railway.
# L'hôte doit finir par .proxy.rlwy.net et le port avoir 5 chiffres.
DATABASE_URL=

# Environnement
NODE_ENV=development

# Journalisation
LOG_LEVEL=debug
