{
  "name": "lascenerp-bot",
  "version": "1.0.0",
  "description": "Bot Discord d'administration interne pour La Scène RP",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript",
    "prisma"
  ],
  "author": "La Scène RP",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "discord.js": "^14.14.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.12.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  }
}
