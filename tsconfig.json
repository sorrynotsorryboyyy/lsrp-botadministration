{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@core/*": ["core/*"],
      "@commands/*": ["commands/*"],
      "@events/*": ["events/*"],
      "@database/*": ["database/*"],
      "@modules/*": ["modules/*"],
      "@services/*": ["services/*"],
      "@middlewares/*": ["middlewares/*"],
      "@config/*": ["config/*"],
      "@apptypes/*": ["types/*"],
      "@utils/*": ["utils/*"],
      "@jobs/*": ["jobs/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "tsc-alias": {
    "//": "Réécrit les alias en chemins relatifs ET ajoute les extensions .js, obligatoires en ESM.",
    "resolveFullPaths": true
  }
}
